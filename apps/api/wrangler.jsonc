{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zoniva-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Required by Prisma's PostgreSQL driver adapter and Better Auth.
  "compatibility_flags": ["nodejs_compat"],
  // Secrets (DATABASE_URL, BETTER_AUTH_SECRET) go in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3000",
    "WEB_ORIGIN": "http://localhost:3000",
  },
}
